---
// A private page. Everything personal lives in src/data/secret.enc.json as
// ciphertext and is only readable with the password (see scripts/secret-encrypt.mjs).
// Standalone on purpose: no header, palette, music, sitemap entry, or indexing.
import '../styles/global.css';
import payload from '../data/secret.enc.json';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <title>.</title>
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&family=Geist+Mono:wght@400..600&display=swap"
    />
  </head>
  <body>
    <main class="secret" id="secret" data-payload={JSON.stringify(payload)}>
      <form class="gate" id="gate" autocomplete="off">
        <p class="gate__label">[private]</p>
        <h1 class="gate__title">This page is for one person.</h1>
        <label class="gate__field">
          <span class="sr-only">Password</span>
          <input
            id="gate-input"
            type="password"
            inputmode="numeric"
            placeholder="Password"
            autocomplete="off"
            required
          />
        </label>
        <button class="gate__btn" type="submit">Open</button>
        <p class="gate__status" id="gate-status" role="status" aria-live="polite"></p>
      </form>
      <article class="gift" id="gift" hidden></article>
    </main>

    <script>
      type Payload = { iterations: number; salt: string; iv: string; data: string };
      type Video = { title?: string; url: string };
      type Content = {
        heading?: string;
        message?: string;
        videos: Video[];
        playlist?: { label?: string; url: string };
      };

      const root = document.getElementById('secret')!;
      const gate = document.getElementById('gate') as HTMLFormElement;
      const input = document.getElementById('gate-input') as HTMLInputElement;
      const status = document.getElementById('gate-status')!;
      const gift = document.getElementById('gift')!;
      const payload: Payload = JSON.parse(root.dataset.payload!);
      root.removeAttribute('data-payload');

      const bytes = (b64: string) => Uint8Array.from(atob(b64), (c) => c.charCodeAt(0));

      async function decrypt(password: string): Promise<Content> {
        const material = await crypto.subtle.importKey('raw', new TextEncoder().encode(password), 'PBKDF2', false, [
          'deriveKey',
        ]);
        const key = await crypto.subtle.deriveKey(
          { name: 'PBKDF2', hash: 'SHA-256', salt: bytes(payload.salt), iterations: payload.iterations },
          material,
          { name: 'AES-GCM', length: 256 },
          false,
          ['decrypt'],
        );
        // AES-GCM is authenticated: a wrong password throws here.
        const plain = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: bytes(payload.iv) }, key, bytes(payload.data));
        return JSON.parse(new TextDecoder().decode(plain));
      }

      function youtubeId(url: string): string | null {
        try {
          const u = new URL(url);
          const host = u.hostname.replace(/^www\.|^m\./, '');
          let id: string | null = null;
          if (host === 'youtu.be') id = u.pathname.slice(1);
          else if (host === 'youtube.com' || host === 'youtube-nocookie.com') {
            id = u.searchParams.get('v') ?? u.pathname.match(/^\/(?:embed|shorts|live)\/([^/?]+)/)?.[1] ?? null;
          }
          return id && /^[\w-]{6,}$/.test(id) ? id : null;
        } catch {
          return null;
        }
      }

      const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) => {
        const node = document.createElement(tag);
        if (cls) node.className = cls;
        if (text) node.textContent = text;
        return node;
      };

      const safeLink = (url: string, text: string, cls: string) => {
        const a = el('a', cls, text);
        if (/^https:\/\//.test(url)) a.href = url;
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
        return a;
      };

      function render(content: Content) {
        if (content.heading) gift.append(el('h1', 'gift__title', content.heading));
        for (const para of (content.message ?? '').split(/\n{2,}/)) {
          if (para.trim()) gift.append(el('p', 'gift__message', para.trim()));
        }
        content.videos.forEach((video, i) => {
          const section = el('section', 'gift__video');
          const num = String(i + 1).padStart(2, '0');
          const head = el('h2', 'gift__video-title');
          head.append(el('span', 'gift__num', `[${num}]`), ` ${video.title ?? ''}`);
          section.append(head);
          const id = youtubeId(video.url);
          if (id) {
            const frame = el('iframe', 'gift__frame');
            frame.src = `https://www.youtube-nocookie.com/embed/${id}?rel=0`;
            frame.title = video.title ?? `Video ${num}`;
            frame.allow = 'accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen';
            frame.allowFullscreen = true;
            frame.loading = i === 0 ? 'eager' : 'lazy';
            frame.referrerPolicy = 'strict-origin-when-cross-origin';
            section.append(frame);
          } else {
            section.append(safeLink(video.url, 'Watch', 'gift__link'));
          }
          gift.append(section);
        });
        if (content.playlist?.url) {
          gift.append(safeLink(content.playlist.url, content.playlist.label || 'The playlist', 'gift__link'));
        }
      }

      gate.addEventListener('submit', async (event) => {
        event.preventDefault();
        // Only the digits count, so 12,345,678 and 12345678 are the same.
        const password = input.value.replace(/\D/g, '');
        if (!password) return;
        gate.classList.add('is-busy');
        status.textContent = 'Opening...';
        // Let the status paint before the key stretching starts.
        await new Promise((r) => setTimeout(r, 30));
        try {
          render(await decrypt(password));
          gate.hidden = true;
          gift.hidden = false;
        } catch {
          status.textContent = 'Not quite. Try again.';
          input.select();
        } finally {
          gate.classList.remove('is-busy');
        }
      });
    </script>
  </body>
</html>

<style is:global>
  .secret {
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: clamp(32px, 8vw, 96px) var(--gutter);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .gate {
    width: min(100%, 420px);
    display: grid;
    gap: 16px;
  }
  .gate[hidden],
  .gift[hidden] {
    display: none;
  }
  .gate__label {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent-text);
  }
  .gate__title {
    font-size: clamp(30px, 6vw, 44px);
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .gate__field input {
    width: 100%;
    margin-top: 8px;
    padding: 14px 16px;
    font: inherit;
    font-family: var(--font-mono);
    letter-spacing: 0.12em;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .gate__field input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: var(--radius);
  }
  .gate__btn {
    padding: 14px 16px;
    font-weight: 600;
    color: #0e0f11;
    background: var(--accent);
    border: 0;
    border-radius: var(--radius);
    cursor: pointer;
  }
  .gate__btn:hover {
    background: var(--accent-2);
  }
  .gate.is-busy {
    opacity: 0.6;
    pointer-events: none;
  }
  .gate__status {
    min-height: 1.6em;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--muted);
  }

  .gift {
    width: min(100%, 760px);
    display: grid;
    gap: 28px;
    animation: gift-in 0.9s var(--ease) both;
  }
  .gift__title {
    font-size: clamp(36px, 7vw, 64px);
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .gift__message {
    font-size: 19px;
    color: var(--muted);
    white-space: pre-line;
    max-width: 60ch;
  }
  .gift__video {
    display: grid;
    gap: 12px;
  }
  .gift__video-title {
    font-size: 20px;
    letter-spacing: -0.01em;
  }
  .gift__num {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 400;
    color: var(--accent-text);
  }
  .gift__frame {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .gift__link {
    justify-self: start;
    padding: 14px 20px;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .gift__link:hover {
    border-color: var(--accent);
  }
  @keyframes gift-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .gift {
      animation: none;
    }
  }
</style>
