---
// A private page. Everything personal lives in src/data/secret.enc.json as
// ciphertext and is only readable with the password (see scripts/secret-encrypt.mjs).
// Standalone on purpose: its own theme, no header, palette, music, sitemap entry, or indexing.
import '../styles/global.css';
import payload from '../data/secret.enc.json';

// Sticker wallpaper: a jittered grid, so it looks scattered but stays evenly spread.
// Seeded, so every build places things the same way.
let seed = 7;
const rand = () => {
  seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const kinds = ['cat-face', 'meow', 'cat-sit', 'meow', 'cat-face', 'heart', 'paw', 'meow', 'cat-sit', 'cat-face'];
const tones = ['pink', 'sage', 'cream'];
const COLS = 5;
const ROWS = 10;
const stickers = [];
for (let r = 0; r < ROWS; r++) {
  for (let c = 0; c < COLS; c++) {
    const kind = kinds[Math.floor(rand() * kinds.length)];
    stickers.push({
      kind,
      tone: tones[Math.floor(rand() * tones.length)],
      x: (((c + 0.1 + rand() * 0.8) / COLS) * 100).toFixed(1),
      y: (((r + 0.1 + rand() * 0.8) / ROWS) * 100).toFixed(1),
      rot: Math.round(rand() * 44 - 22),
      size: Math.round((kind === 'heart' || kind === 'paw' ? 30 : 58) + rand() * 30),
    });
  }
}
---

<!doctype html>
<html lang="en" class="kitty">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#fde6ec" />
    <title>meow</title>
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400..700&family=Nunito:wght@400..800&display=swap"
    />
  </head>
  <body>
    <!-- Cat drawings, reused everywhere with <use>. Colors come from --fur on the sticker. -->
    <svg class="k-defs" aria-hidden="true" width="0" height="0">
      <symbol id="cat-face" viewBox="0 0 120 110">
        <g stroke="var(--ink)" stroke-width="4" stroke-linejoin="round" stroke-linecap="round">
          <path d="M20 50 L15 9 L52 28 Z" fill="var(--fur)"></path>
          <path d="M100 50 L105 9 L68 28 Z" fill="var(--fur)"></path>
          <ellipse cx="60" cy="64" rx="48" ry="40" fill="var(--fur)"></ellipse>
        </g>
        <path d="M24 32 L22 19 L35 26 Z" fill="var(--ear)"></path>
        <path d="M96 32 L98 19 L85 26 Z" fill="var(--ear)"></path>
        <ellipse cx="42" cy="62" rx="4.5" ry="6" fill="var(--ink)"></ellipse>
        <ellipse cx="78" cy="62" rx="4.5" ry="6" fill="var(--ink)"></ellipse>
        <circle cx="43.5" cy="59.5" r="1.6" fill="#fff"></circle>
        <circle cx="79.5" cy="59.5" r="1.6" fill="#fff"></circle>
        <ellipse cx="27" cy="75" rx="8" ry="4.5" fill="var(--blush)"></ellipse>
        <ellipse cx="93" cy="75" rx="8" ry="4.5" fill="var(--blush)"></ellipse>
        <path d="M55.5 70 h9 l-4.5 5 z" fill="var(--nose)" stroke="var(--nose)" stroke-width="2" stroke-linejoin="round"></path>
        <g fill="none" stroke="var(--ink)" stroke-width="3" stroke-linecap="round">
          <path d="M60 76 q-5 8 -12 2"></path>
          <path d="M60 76 q5 8 12 2"></path>
          <path d="M3 62 L17 65 M3 76 L17 73 M117 62 L103 65 M117 76 L103 73"></path>
        </g>
        <path
          d="M92 34 C80 26 85 15 92 21 C99 15 104 26 92 34 Z"
          fill="var(--nose)"
          stroke="var(--ink)"
          stroke-width="2.5"
          stroke-linejoin="round"></path>
      </symbol>
      <symbol id="cat-sit" viewBox="0 0 130 162">
        <path d="M94 134 C130 136 126 98 108 94" fill="none" stroke="var(--ink)" stroke-width="18" stroke-linecap="round"></path>
        <path d="M94 134 C130 136 126 98 108 94" fill="none" stroke="var(--fur)" stroke-width="10" stroke-linecap="round"></path>
        <ellipse cx="62" cy="120" rx="38" ry="36" fill="var(--fur)" stroke="var(--ink)" stroke-width="4"></ellipse>
        <ellipse cx="62" cy="128" rx="19" ry="21" fill="#fff" opacity="0.65"></ellipse>
        <g fill="var(--fur)" stroke="var(--ink)" stroke-width="4">
          <ellipse cx="44" cy="152" rx="13" ry="8"></ellipse>
          <ellipse cx="80" cy="152" rx="13" ry="8"></ellipse>
        </g>
        <use href="#cat-face" x="6" y="0" width="112" height="103"></use>
      </symbol>
      <symbol id="paw" viewBox="0 0 60 56">
        <g fill="var(--fur)">
          <ellipse cx="30" cy="39" rx="15" ry="12"></ellipse>
          <circle cx="11" cy="24" r="6.5"></circle>
          <circle cx="23" cy="12" r="6.5"></circle>
          <circle cx="38" cy="12" r="6.5"></circle>
          <circle cx="49" cy="24" r="6.5"></circle>
        </g>
      </symbol>
      <symbol id="heart" viewBox="0 0 60 56">
        <path d="M30 52 C-12 26 8 -6 30 15 C52 -6 72 26 30 52 Z" fill="var(--fur)"></path>
      </symbol>
    </svg>

    <main class="secret" id="secret" data-payload={JSON.stringify(payload)}>
      <div class="wall" aria-hidden="true">
        {
          stickers.map((s) =>
            s.kind === 'meow' ? (
              <span class={`wall__item meow meow--${s.tone}`} style={`left:${s.x}%;top:${s.y}%;--r:${s.rot}deg`}>
                meow
              </span>
            ) : (
              <svg
                class={`wall__item k-art k-art--${s.kind} tone-${s.tone}`}
                style={`left:${s.x}%;top:${s.y}%;--r:${s.rot}deg;--s:${s.size}px`}
              >
                <use href={`#${s.kind}`} />
              </svg>
            ),
          )
        }
      </div>

      <form class="gate" id="gate" autocomplete="off">
        <svg class="peek k-art k-art--cat-face tone-cream" aria-hidden="true"><use href="#cat-face"></use></svg>
        <div class="card card--pink gate__card">
          <span class="meow meow--sage corner corner--tr" aria-hidden="true">meow</span>
          <h1 class="gate__title">This page is for one person.</h1>
          <label class="gate__field">
            <span class="sr-only">Password</span>
            <input
              id="gate-input"
              type="password"
              inputmode="numeric"
              placeholder="Password"
              autocomplete="off"
              required
            />
          </label>
          <button class="pill" type="submit">
            <svg class="k-art k-art--paw pill__paw" aria-hidden="true"><use href="#paw"></use></svg>
            Open
          </button>
          <p class="gate__status" id="gate-status" role="status" aria-live="polite"></p>
        </div>
      </form>

      <article class="gift" id="gift" hidden>
        <section class="card card--sage letter">
          <span class="meow meow--pink corner corner--tr" aria-hidden="true">meow</span>
          <h1 class="gift__title" id="gift-title"></h1>
          <div class="letter__body" id="gift-letter"></div>
          <div class="letter__cats" aria-hidden="true">
            <span class="meow meow--sage">meow</span>
            <svg class="k-art k-art--cat-sit tone-pink"><use href="#cat-sit"></use></svg>
            <svg class="k-art k-art--cat-sit tone-cream"><use href="#cat-sit"></use></svg>
          </div>
        </section>

        <div class="videos" id="gift-videos"></div>

        <div class="playlist" id="gift-playlist">
          <svg class="k-art k-art--cat-face tone-sage playlist__cat" aria-hidden="true"><use href="#cat-face"></use></svg>
        </div>
      </article>
    </main>

    <!-- Cloned once per video by the script. -->
    <template id="video-template">
      <section class="video">
        <svg class="peek k-art k-art--cat-face tone-pink" aria-hidden="true"><use href="#cat-face"></use></svg>
        <div class="card card--pink video__card">
          <span class="meow meow--cream corner corner--bl" aria-hidden="true">meow</span>
          <h2 class="video__title"></h2>
        </div>
      </section>
    </template>

    <script>
      type Payload = { iterations: number; salt: string; entries: { iv: string; data: string }[] };
      type Video = { title?: string; url: string };
      type Content = {
        heading?: string;
        message?: string;
        videos: Video[];
        playlist?: { label?: string; url: string };
      };

      const root = document.getElementById('secret')!;
      const gate = document.getElementById('gate') as HTMLFormElement;
      const input = document.getElementById('gate-input') as HTMLInputElement;
      const status = document.getElementById('gate-status')!;
      const gift = document.getElementById('gift')!;
      const payload: Payload = JSON.parse(root.dataset.payload!);
      root.removeAttribute('data-payload');

      const bytes = (b64: string) => Uint8Array.from(atob(b64), (c) => c.charCodeAt(0));

      async function decrypt(password: string): Promise<Content> {
        const material = await crypto.subtle.importKey('raw', new TextEncoder().encode(password), 'PBKDF2', false, [
          'deriveKey',
        ]);
        const key = await crypto.subtle.deriveKey(
          { name: 'PBKDF2', hash: 'SHA-256', salt: bytes(payload.salt), iterations: payload.iterations },
          material,
          { name: 'AES-GCM', length: 256 },
          false,
          ['decrypt'],
        );
        // AES-GCM is authenticated: an entry made with a different password throws.
        for (const entry of payload.entries) {
          try {
            const plain = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: bytes(entry.iv) }, key, bytes(entry.data));
            return JSON.parse(new TextDecoder().decode(plain));
          } catch {
            // Try the next entry.
          }
        }
        throw new Error('wrong password');
      }

      function youtubeId(url: string): string | null {
        try {
          const u = new URL(url);
          const host = u.hostname.replace(/^www\.|^m\./, '');
          let id: string | null = null;
          if (host === 'youtu.be') id = u.pathname.slice(1);
          else if (host === 'youtube.com' || host === 'youtube-nocookie.com') {
            id = u.searchParams.get('v') ?? u.pathname.match(/^\/(?:embed|shorts|live)\/([^/?]+)/)?.[1] ?? null;
          }
          return id && /^[\w-]{6,}$/.test(id) ? id : null;
        } catch {
          return null;
        }
      }

      const safeLink = (url: string, text: string, cls: string) => {
        const a = document.createElement('a');
        a.className = cls;
        a.textContent = text;
        if (/^https:\/\//.test(url)) a.href = url;
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
        return a;
      };

      function render(content: Content) {
        document.getElementById('gift-title')!.textContent = content.heading ?? '';
        const letter = document.getElementById('gift-letter')!;
        for (const para of (content.message ?? '').split(/\n{2,}/)) {
          if (!para.trim()) continue;
          const p = document.createElement('p');
          p.textContent = para.trim();
          letter.append(p);
        }

        const videos = document.getElementById('gift-videos')!;
        const template = document.getElementById('video-template') as HTMLTemplateElement;
        content.videos.forEach((video, i) => {
          const section = template.content.cloneNode(true) as DocumentFragment;
          const card = section.querySelector('.video__card')!;
          section.querySelector('.video__title')!.textContent = video.title ?? '';
          const id = youtubeId(video.url);
          if (id) {
            const frame = document.createElement('iframe');
            frame.className = 'video__frame';
            frame.src = `https://www.youtube-nocookie.com/embed/${id}?rel=0`;
            frame.title = video.title ?? `Video ${i + 1}`;
            frame.allow = 'accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen';
            frame.allowFullscreen = true;
            frame.loading = i === 0 ? 'eager' : 'lazy';
            frame.referrerPolicy = 'strict-origin-when-cross-origin';
            card.append(frame);
            // In case the player refuses to load inside the page.
            card.append(safeLink(`https://youtu.be/${id}`, 'Open on YouTube', 'video__fallback'));
          } else {
            card.append(safeLink(video.url, 'Watch', 'pill'));
          }
          videos.append(section);
        });

        if (content.playlist?.url) {
          document
            .getElementById('gift-playlist')!
            .append(safeLink(content.playlist.url, content.playlist.label || 'The playlist', 'pill pill--sage'));
        }
      }

      gate.addEventListener('submit', async (event) => {
        event.preventDefault();
        // Only the digits count, so 12,345,678 and 12345678 are the same.
        const password = input.value.replace(/\D/g, '');
        if (!password) return;
        gate.classList.add('is-busy');
        status.textContent = 'Opening...';
        // Let the status paint before the key stretching starts.
        await new Promise((r) => setTimeout(r, 30));
        try {
          render(await decrypt(password));
          gate.hidden = true;
          gift.hidden = false;
          window.scrollTo(0, 0);
        } catch {
          status.textContent = 'Not quite. Try again.';
          input.select();
        } finally {
          gate.classList.remove('is-busy');
        }
      });
    </script>
  </body>
</html>

<style is:global>
  /* Pink and sage, on this page only. */
  html.kitty {
    --k-bg: #fde6ec;
    --k-dot: #f8cbd8;
    --k-paper: #fffaf6;
    --k-pink: #f7b3c8;
    --k-pink-soft: #ffdbe5;
    --k-pink-deep: #c9477a;
    --k-sage: #a9c29b;
    --k-sage-soft: #d6e4cb;
    --k-sage-deep: #4f7149;
    --k-text: #57414b;
    --ink: #6b4a57;
    --ear: #f7a9c0;
    --blush: #f9b4c8;
    --nose: #ee7fa3;
    --fur: #fffaf6;
    --k-display: 'Fredoka', ui-rounded, 'Arial Rounded MT Bold', system-ui, sans-serif;
    --k-body: 'Nunito', ui-rounded, system-ui, sans-serif;
    color-scheme: light;
    background: var(--k-bg);
  }
  html.kitty body {
    background-color: var(--k-bg);
    background-image: radial-gradient(var(--k-dot) 2px, transparent 2.5px);
    background-size: 26px 26px;
    color: var(--k-text);
    font-family: var(--k-body);
    font-size: 18px;
  }
  html.kitty ::selection {
    background: var(--k-pink);
    color: var(--k-text);
  }
  html.kitty :focus-visible {
    outline: 3px solid var(--k-sage-deep);
    outline-offset: 3px;
    border-radius: 999px;
  }
  .kitty .k-defs {
    position: absolute;
  }
  .kitty .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .kitty .secret {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: clamp(72px, 10vw, 120px) 16px clamp(48px, 8vw, 96px);
    overflow: hidden;
    overflow: clip;
  }

  /* Cats and stickers */
  .kitty .tone-pink {
    --fur: #ffd3df;
    --ear: #f493b1;
  }
  .kitty .tone-sage {
    --fur: #d3e2c7;
    --ear: #f7a9c0;
  }
  .kitty .tone-cream {
    --fur: #fffaf6;
  }
  .kitty .k-art {
    width: var(--s, 72px);
    height: auto;
    aspect-ratio: 120 / 110;
    overflow: visible;
  }
  .kitty .k-art--cat-sit {
    aspect-ratio: 130 / 162;
  }
  .kitty .k-art--paw,
  .kitty .k-art--heart {
    aspect-ratio: 60 / 56;
  }
  .kitty .k-art--paw.tone-cream,
  .kitty .k-art--heart.tone-cream {
    --fur: #f9b9cb;
  }
  .kitty .k-art--paw.tone-sage,
  .kitty .k-art--heart.tone-sage {
    --fur: #b4cba6;
  }
  .kitty .k-art--paw.tone-pink,
  .kitty .k-art--heart.tone-pink {
    --fur: #f596b4;
  }
  .kitty .meow {
    display: inline-block;
    padding: 4px 16px 6px;
    font-family: var(--k-display);
    font-weight: 600;
    font-size: 20px;
    line-height: 1.2;
    color: var(--k-pink-deep);
    background: var(--k-pink-soft);
    border: 3px solid #fff;
    border-radius: 999px;
    box-shadow: 0 3px 0 rgba(107, 74, 87, 0.16);
    white-space: nowrap;
  }
  .kitty .meow--sage {
    color: var(--k-sage-deep);
    background: var(--k-sage-soft);
  }
  .kitty .meow--cream {
    background: var(--k-paper);
  }

  .kitty .wall {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .kitty .wall__item {
    position: absolute;
    transform: translate(-50%, -50%) rotate(var(--r, 0deg));
  }
  @media (max-width: 640px) {
    .kitty .wall__item:nth-child(3n) {
      display: none;
    }
    .kitty .wall .k-art {
      width: calc(var(--s) * 0.72);
    }
    .kitty .wall .meow {
      font-size: 15px;
      padding: 2px 11px 4px;
    }
  }

  /* Cards */
  .kitty .card {
    position: relative;
    background: var(--k-paper);
    border: 3px solid var(--k-pink);
    border-radius: 30px;
    box-shadow: 0 8px 0 var(--k-pink-soft);
    padding: clamp(22px, 5vw, 40px);
  }
  .kitty .card--sage {
    border-color: var(--k-sage);
    box-shadow: 0 8px 0 var(--k-sage-soft);
  }
  .kitty .corner {
    position: absolute;
    z-index: 1;
  }
  .kitty .corner--tr {
    top: -18px;
    right: -6px;
    transform: rotate(9deg);
  }
  .kitty .corner--bl {
    bottom: -18px;
    left: -6px;
    transform: rotate(-8deg);
  }
  /* A cat looking over the top edge of a card, with its paws on the edge. */
  .kitty .peek {
    --s: 104px;
    position: absolute;
    top: -68px;
    left: 34px;
  }
  .kitty .peek + .card::before,
  .kitty .peek + .card::after {
    content: '';
    position: absolute;
    top: -12px;
    left: 44px;
    width: 26px;
    height: 20px;
    background: var(--peek-fur, #fffaf6);
    border: 3.5px solid var(--ink);
    border-radius: 50%;
  }
  .kitty .peek + .card::after {
    left: 100px;
  }
  .kitty .video .peek + .card {
    --peek-fur: #ffd3df;
  }

  .kitty .pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 13px 26px;
    font-family: var(--k-display);
    font-weight: 600;
    font-size: 19px;
    color: #4a2a38;
    text-decoration: none;
    background: var(--k-pink);
    border: 3px solid #fff;
    border-radius: 999px;
    box-shadow: 0 5px 0 #e58fab;
    cursor: pointer;
    transition: transform 0.15s var(--ease), box-shadow 0.15s var(--ease);
  }
  .kitty .pill:hover {
    color: #4a2a38;
    transform: translateY(-2px);
    box-shadow: 0 7px 0 #e58fab;
  }
  .kitty .pill:active {
    transform: translateY(3px);
    box-shadow: 0 2px 0 #e58fab;
  }
  .kitty .pill--sage {
    color: #2c4428;
    background: var(--k-sage);
    box-shadow: 0 5px 0 #86a577;
  }
  .kitty .pill--sage:hover {
    color: #2c4428;
    box-shadow: 0 7px 0 #86a577;
  }
  .kitty .pill--sage:active {
    box-shadow: 0 2px 0 #86a577;
  }
  .kitty .pill__paw {
    --s: 22px;
    --fur: #4a2a38;
  }

  /* Locked */
  .kitty .gate {
    position: relative;
    width: min(100%, 420px);
  }
  .kitty .gate[hidden],
  .kitty .gift[hidden] {
    display: none;
  }
  .kitty .gate__card {
    display: grid;
    gap: 16px;
  }
  .kitty .gate__title {
    font-family: var(--k-display);
    font-weight: 600;
    font-size: clamp(28px, 7vw, 38px);
    line-height: 1.15;
    letter-spacing: 0;
    color: var(--k-pink-deep);
    text-wrap: balance;
  }
  .kitty .gate__field input {
    width: 100%;
    padding: 13px 20px;
    font: inherit;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--k-text);
    background: #fff;
    border: 3px solid var(--k-sage);
    border-radius: 999px;
  }
  .kitty .gate__field input::placeholder {
    color: #8e7a83;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .kitty .gate.is-busy {
    opacity: 0.65;
    pointer-events: none;
  }
  .kitty .gate__status {
    min-height: 1.6em;
    font-weight: 700;
    font-size: 16px;
    color: var(--k-sage-deep);
    text-align: center;
  }

  /* Unlocked */
  .kitty .gift {
    width: min(100%, 720px);
    display: grid;
    gap: clamp(72px, 12vw, 96px);
    animation: gift-in 0.9s var(--ease) both;
  }
  .kitty .gift__title {
    font-family: var(--k-display);
    font-weight: 600;
    font-size: clamp(34px, 8vw, 56px);
    line-height: 1.1;
    letter-spacing: 0;
    color: var(--k-pink-deep);
    text-wrap: balance;
  }
  .kitty .letter__body {
    margin-top: 20px;
    display: grid;
    gap: 1em;
    font-size: clamp(17px, 2.4vw, 19px);
    line-height: 1.75;
  }
  .kitty .letter__cats {
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 24px;
  }
  .kitty .letter__cats .k-art {
    --s: 64px;
  }
  .kitty .letter__cats .k-art:last-child {
