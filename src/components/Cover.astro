---
// Renders a cover from either source: a co-located image (optimized by Astro)
// or a public path such as /uploads/x.jpg written by the web editor.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  class?: string;
  eager?: boolean;
}
// `rest` carries the parent's scoped-style attribute, so its CSS still applies.
const { src, alt, class: className, eager = false, ...rest } = Astro.props;
const loading = eager ? 'eager' : 'lazy';
---

{
  typeof src === 'string' ? (
    <img class={className} {...rest} src={src} alt={alt} loading={loading} decoding="async" />
  ) : (
    <Image class={className} {...rest} src={src} alt={alt} width={1280} widths={[640, 960, 1280]} sizes="(max-width: 1200px) 100vw, 1120px" loading={loading} />
  )
}
