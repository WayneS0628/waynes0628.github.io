---
// Projects as points in a 2D "latent space". Positions come from
// src/data/project-map.json (regenerate with `npm run map`). Every point is a
// plain link, so the map works without JavaScript; the list view is a
// simpler alternative for anyone who'd rather not hunt for dots.
import { getCollection } from 'astro:content';
import Status from './Status.astro';
import map from '../data/project-map.json';

const projects = await getCollection('projects', ({ data }) => !data.draft);
const byId = new Map(projects.map((p) => [p.id, p]));
const points = map.points.filter((pt) => byId.has(pt.id));
const pos = new Map(points.map((pt) => [pt.id, pt]));
const missing = projects.filter((p) => !pos.has(p.id)); // added since the last `npm run map`
const lines = points
  .filter((pt) => pt.nearest && pos.has(pt.nearest))
  .map((pt) => ({ a: pt, b: pos.get(pt.nearest!)! }));
---

<div class="pmap" data-view="map">
  <div class="pmap__bar">
    <p class="mono pmap__how">
      Each dot is a project, placed by what it's about: descriptions embedded with <code>{map.model.split('/')[1]}</code>,
      then reduced to 2D with PCA. Closer dots, more similar work.
    </p>
    <div class="pmap__toggle" role="group" aria-label="View">
      <button class="btn-text" type="button" data-view-btn="map" aria-pressed="true">[map]</button>
      <button class="btn-text" type="button" data-view-btn="list" aria-pressed="false">[list]</button>
    </div>
  </div>

  <div class="pmap__canvas">
    <svg class="pmap__lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      {lines.map(({ a, b }) => <line x1={a.x * 100} y1={(1 - a.y) * 100} x2={b.x * 100} y2={(1 - b.y) * 100} />)}
    </svg>
    <span class="label pmap__axis pmap__axis--x">[pc1] →</span>
    <span class="label pmap__axis pmap__axis--y">[pc2] ↑</span>
    {
      points.map((pt) => {
        const p = byId.get(pt.id)!;
        const side = pt.x > 0.6 ? 'left' : 'right';
        const vert = pt.y > 0.6 ? 'below' : 'above';
        return (
          <a
            class={`pmap__pt pmap__pt--${p.data.status} is-${side} is-${vert}`}
            href={`/work/${p.id}/`}
            style={`left:${pt.x * 100}%;top:${(1 - pt.y) * 100}%`}
          >
            <span class="pmap__dot" aria-hidden="true" />
            <span class="pmap__name">{p.data.title}</span>
            <span class="pmap__card" aria-hidden="true">
              <Status status={p.data.status} />
              <span class="pmap__card-title">{p.data.title}</span>
              <span class="pmap__card-sum">{p.data.summary}</span>
              {pt.nearest && byId.has(pt.nearest) && (
                <span class="label">nearest: {byId.get(pt.nearest)!.data.title}</span>
              )}
            </span>
          </a>
        );
      })
    }
  </div>

  <ol class="pmap__list">
    {
      [...points.map((pt) => byId.get(pt.id)!), ...missing].map((p) => (
        <li>
          <a href={`/work/${p.id}/`}>{p.data.title}</a>
          <span class="pmap__list-sum">{p.data.summary}</span>
          <Status status={p.data.status} />
        </li>
      ))
    }
  </ol>
</div>

<style>
  .pmap__bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px 32px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .pmap__how {
    max-width: 62ch;
    color: var(--muted);
    line-height: 1.6;
  }
  .pmap__how code {
    color: var(--accent-text);
  }
  .pmap__toggle {
    display: flex;
    gap: 6px;
  }
  .pmap__canvas {
    position: relative;
    aspect-ratio: 16 / 8;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background:
      linear-gradient(var(--border) 1px, transparent 1px) 0 0 / 10% 12.5%,
      linear-gradient(90deg, var(--border) 1px, transparent 1px) 0 0 / 10% 12.5%,
      var(--surface);
    background-blend-mode: normal;
    overflow: hidden;
  }
  .pmap__canvas::before {
    /* soften the grid toward the edges */
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 30%, var(--surface) 95%);
    pointer-events: none;
  }
  .pmap__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .pmap__lines line {
    stroke: var(--accent);
    stroke-width: 1;
    stroke-dasharray: 3 4;
    vector-effect: non-scaling-stroke;
    opacity: 0.45;
  }
  .pmap__axis {
    position: absolute;
    font-size: 10px;
  }
  .pmap__axis--x {
    right: 12px;
    bottom: 10px;
  }
  .pmap__axis--y {
    left: 12px;
    top: 10px;
  }
  .pmap__pt {
    position: absolute;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 10px;
    transform: translate(-7px, -50%);
    text-decoration: none;
  }
  .pmap__pt.is-left {
    flex-direction: row-reverse;
    transform: translate(calc(-100% + 7px), -50%);
  }
  .pmap__dot {
    flex: none;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0 4px color-mix(in srgb, currentColor 20%, transparent);
    transition: box-shadow 0.25s var(--ease), transform 0.25s var(--ease);
  }
  .pmap__pt--shipped { color: var(--ok); }
  .pmap__pt--training { color: var(--accent-2); }
  .pmap__pt--planned { color: var(--muted); }
  .pmap__name {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text);
    white-space: nowrap;
    padding: 2px 6px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--surface) 80%, transparent);
  }
  .pmap__pt:hover,
  .pmap__pt:focus-visible {
    z-index: 2;
    outline: none;
  }
  .pmap__pt:hover .pmap__dot,
  .pmap__pt:focus-visible .pmap__dot {
    transform: scale(1.25);
    box-shadow: 0 0 0 8px color-mix(in srgb, currentColor 25%, transparent);
  }
  .pmap__pt:focus-visible .pmap__name {
    outline: 2px solid var(--accent);
  }
  /* Hover/focus preview card */
  .pmap__card {
    position: absolute;
    width: 260px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--text);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
    opacity: 0;
    pointer-events: none;
    transform: translateY(4px);
    transition: opacity 0.18s var(--ease), transform 0.18s var(--ease);
  }
  .is-right .pmap__card { left: 0; }
  .is-left .pmap__card { right: 0; }
  .is-above .pmap__card { bottom: calc(100% + 14px); }
  .is-below .pmap__card { top: calc(100% + 14px); }
  .pmap__pt:hover .pmap__card,
  .pmap__pt:focus-visible .pmap__card {
    opacity: 1;
    transform: none;
  }
  .pmap__card-title {
    font-weight: 600;
    font-size: 16px;
  }
  .pmap__card-sum {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.45;
  }

  .pmap__list {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .pmap__list li {
    display: grid;
    grid-template-columns: minmax(180px, 1fr) 2fr auto;
    gap: 6px 24px;
    align-items: baseline;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
  }
  .pmap__list a {
    font-weight: 600;
    text-decoration: none;
  }
  .pmap__list-sum {
    color: var(--muted);
    font-size: 15px;
  }
  .pmap[data-view='list'] .pmap__canvas {
    display: none;
  }
  .pmap[data-view='list'] .pmap__list {
    display: block;
  }

  @media (max-width: 700px) {
    .pmap__canvas {
      aspect-ratio: 4 / 5;
    }
    /* Narrow screens: label centered under the dot, so neighbors don't collide */
    .pmap__pt,
    .pmap__pt.is-left {
      flex-direction: column;
      gap: 6px;
      transform: translate(-50%, -7px);
    }
    /* lower half of the map: label goes above the dot so the frame doesn't clip it */
    .pmap__pt.is-above {
      flex-direction: column-reverse;
      transform: translate(-50%, calc(-100% + 7px));
    }
    .pmap__name {
      font-size: 10px;
      white-space: normal;
      text-align: center;
      max-width: 13ch;
    }
    .pmap__card {
      display: none;
    }
    .pmap__list li {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Delegated, so it keeps working when the homepage is re-rendered by client-side navigation.
  document.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('[data-view-btn]');
    const root = b?.closest<HTMLElement>('.pmap');
    if (!b || !root) return;
    root.dataset.view = b.dataset.viewBtn;
    root.querySelectorAll('[data-view-btn]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
  });
</script>
